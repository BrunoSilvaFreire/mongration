{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "task: test:debug",
            "type": "shell",
            "command": "task",
            "args": [
                "test:debug"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting tests with debugpy",
                    "endsPattern": "Waiting for client to connect"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Cleanup Debug Process",
            "type": "shell",
            "command": "pkill",
            "args": [
                "-f",
                "debugpy.*behave"
            ],
            "presentation": {
                "echo": false,
                "reveal": "never",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}
